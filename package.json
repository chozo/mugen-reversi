{
  "name": "mugen-othello",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "node --experimental-strip-types --no-warnings tools/simulate.ts",
    "sim:ai": "node --experimental-strip-types --no-warnings tools/ai-match.ts",
    "e2e": "node tools/e2e.mjs",
    "deploy": "npm run build && wrangler deploy",
    "promo": "npm run build && node tools/promo/record.mjs"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
